# ─────────────────────────────────────────────────────────────────────────────
# VyaparOne Frontend — Environment Variable Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# URL of the backend API. Defaults to localhost for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Demo / Quick Launcher (LOCAL DEVELOPMENT ONLY) ────────────────────────────
# Set NEXT_PUBLIC_DEMO_MODE=true to enable the Quick Demo Launcher on the login
# page. This causes the bundler to include demo credential strings in the build.
#
# NEVER set NEXT_PUBLIC_DEMO_MODE=true in a production/staging environment or
# in Vercel production env vars — doing so ships credentials in the JS bundle.
#
# When enabled, set the account credentials via the vars below (do NOT hardcode
# them in source code). These values are read at build time.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASS=
NEXT_PUBLIC_DEMO_OWNER_EMAIL=
NEXT_PUBLIC_DEMO_OWNER_PASS=
