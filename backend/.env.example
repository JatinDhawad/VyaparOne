# ─────────────────────────────────────────────────────────────────────────────
# VyaparOne Backend — Environment Variable Template
# Copy this file to .env and fill in the real values before starting the app.
# NEVER commit .env (with real values) to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security ─────────────────────────────────────────────────────────────────
# Required. The app will refuse to start if this is absent or empty.
# Generate a secure value with:  openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-value

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite (local dev only).  Override with a PostgreSQL URL in production.
# DATABASE_URL=postgresql://user:password@host:5432/vyaparone

# ── Seed Script ───────────────────────────────────────────────────────────────
# Only used to CREATE the default admin when none exists. It never overwrites an
# existing admin's password. If no admin exists and this is not set, seeding aborts.
# Example:  ADMIN_SEED_PASSWORD=$(openssl rand -base64 20)
ADMIN_SEED_PASSWORD=replace-with-a-strong-seed-password

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON list of exact frontend origins allowed to call the API (no wildcards).
# CORS_ORIGINS=["https://your-app.vercel.app"]

# ── Accounting policy ─────────────────────────────────────────────────────────
# false = GST paid on purchases counts as part of product cost (default; GST filing is handled by the CA).
# true  = purchase GST is claimed back as Input Tax Credit and left out of cost.
# INPUT_GST_CLAIMED_AS_ITC=false
